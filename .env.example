# Galaxy-Memory environment template — copy to .env.local and fill in.
# With EVERYTHING unset, the web app runs in LocalStorage Demo Mode and the
# MCP server uses a local JSON file — fully working, zero config.

# --- Embeddings (shared by web + MCP) -------------------------------------
# EMBEDDING_PROVIDER: openai | ollama | local  (auto: openai if key set, else local)
EMBEDDING_PROVIDER=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- Web app (apps/web) ---------------------------------------------------
# Vite exposes only VITE_* vars to the browser. Set both to leave Demo Mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: browser-side embeddings (self-hosted single-user use only — the
# key ships to the client). Without it, demo/local embeddings are used.
VITE_OPENAI_API_KEY=
VITE_EMBEDDING_PROVIDER=
VITE_OLLAMA_URL=http://localhost:11434
VITE_USER_NAME=Tomáš

# --- MCP server (packages/mcp-server) -------------------------------------
# Service role is preferred server-side; anon works with permissive RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: custom path for the local JSON file backend (default ~/.galaxy-memory/memories.json)
GALAXY_MEMORY_DB=
